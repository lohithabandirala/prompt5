# Server-side only. Never expose this value to the browser or commit it.
GEMINI_API_KEY=your-api-key-here

# Optional: model identifier (defaults to gemini-3.6-flash).
GEMINI_MODEL=gemini-3.6-flash

# Optional: override the provider base URL. Intended for an approved gateway or
# the local mock provider used by the Playwright end-to-end tests.
# GEMINI_API_BASE_URL=http://127.0.0.1:4010
